# Development environment configuration
ENVIRONMENT=dev
NAMESPACE=stock-app-dev
IMAGE_REGISTRY=docker.io/noletengine
IMAGE_TAG=latest
NODE_ENV=development

# Replica counts (minimal for dev)
FRONTEND_REPLICAS=1
API_GATEWAY_REPLICAS=1
ORDERS_V1_REPLICAS=1
ORDERS_V2_REPLICAS=0
INVENTORY_V1_REPLICAS=1
INVENTORY_V2_REPLICAS=0
USERS_V1_REPLICAS=1
USERS_V2_REPLICAS=0
REVIEWS_V1_REPLICAS=1
REVIEWS_V2_REPLICAS=0
REVIEWS_V3_REPLICAS=0
RATINGS_V1_REPLICAS=1
RATINGS_V2_REPLICAS=0

# Resource limits (minimal for dev)
FRONTEND_MEMORY_REQUEST=64Mi
FRONTEND_CPU_REQUEST=50m
FRONTEND_MEMORY_LIMIT=128Mi
FRONTEND_CPU_LIMIT=100m

API_GATEWAY_MEMORY_REQUEST=128Mi
API_GATEWAY_CPU_REQUEST=100m
API_GATEWAY_MEMORY_LIMIT=256Mi
API_GATEWAY_CPU_LIMIT=200m

SERVICE_MEMORY_REQUEST=64Mi
SERVICE_CPU_REQUEST=50m
SERVICE_MEMORY_LIMIT=128Mi
SERVICE_CPU_LIMIT=100m

# Health check timings (faster for dev)
LIVENESS_DELAY=15
READINESS_DELAY=5

# Service names
ORDERS_SERVICE_NAME=orders-service
INVENTORY_SERVICE_NAME=inventory-service
USERS_SERVICE_NAME=users-service
REVIEWS_SERVICE_NAME=reviews-service
RATINGS_SERVICE_NAME=ratings-service

# Istio settings (disabled for dev)
ISTIO_ENABLED=false