# Production environment configuration
ENVIRONMENT=prod
NAMESPACE=stock-app-production
IMAGE_REGISTRY=docker.io/noletengine
IMAGE_TAG=stable-latest
NODE_ENV=production

# Replica counts (high availability for production)
FRONTEND_REPLICAS=3
API_GATEWAY_REPLICAS=3
ORDERS_V1_REPLICAS=3
ORDERS_V2_REPLICAS=1
INVENTORY_V1_REPLICAS=3
INVENTORY_V2_REPLICAS=1
USERS_V1_REPLICAS=3
USERS_V2_REPLICAS=1
REVIEWS_V1_REPLICAS=2
REVIEWS_V2_REPLICAS=2
REVIEWS_V3_REPLICAS=1
RATINGS_V1_REPLICAS=3
RATINGS_V2_REPLICAS=1

# Resource limits (high for production)
FRONTEND_MEMORY_REQUEST=256Mi
FRONTEND_CPU_REQUEST=200m
FRONTEND_MEMORY_LIMIT=512Mi
FRONTEND_CPU_LIMIT=500m

API_GATEWAY_MEMORY_REQUEST=512Mi
API_GATEWAY_CPU_REQUEST=500m
API_GATEWAY_MEMORY_LIMIT=1Gi
API_GATEWAY_CPU_LIMIT=1000m

SERVICE_MEMORY_REQUEST=256Mi
SERVICE_CPU_REQUEST=200m
SERVICE_MEMORY_LIMIT=512Mi
SERVICE_CPU_LIMIT=500m

# Health check timings (conservative for production)
LIVENESS_DELAY=30
READINESS_DELAY=10

# Service names
ORDERS_SERVICE_NAME=orders-service
INVENTORY_SERVICE_NAME=inventory-service
USERS_SERVICE_NAME=users-service
REVIEWS_SERVICE_NAME=reviews-service
RATINGS_SERVICE_NAME=ratings-service

# Istio settings (enabled with strict security)
ISTIO_ENABLED=true
ISTIO_FAULT_INJECTION=false
ISTIO_MTLS_MODE=STRICT

# Production-specific settings
ENABLE_MONITORING=true
ENABLE_AUTOSCALING=true
MIN_REPLICAS=2
MAX_REPLICAS=10
CPU_TARGET=60
MEMORY_TARGET=70