# Staging environment configuration
ENVIRONMENT=stage
NAMESPACE=stock-app-staging
IMAGE_REGISTRY=docker.io/noletengine
IMAGE_TAG=staging-latest
NODE_ENV=staging

# Replica counts (moderate for staging)
FRONTEND_REPLICAS=2
API_GATEWAY_REPLICAS=2
ORDERS_V1_REPLICAS=2
ORDERS_V2_REPLICAS=1
INVENTORY_V1_REPLICAS=2
INVENTORY_V2_REPLICAS=1
USERS_V1_REPLICAS=2
USERS_V2_REPLICAS=1
REVIEWS_V1_REPLICAS=2
REVIEWS_V2_REPLICAS=1
REVIEWS_V3_REPLICAS=1
RATINGS_V1_REPLICAS=2
RATINGS_V2_REPLICAS=1

# Resource limits (moderate for staging)
FRONTEND_MEMORY_REQUEST=128Mi
FRONTEND_CPU_REQUEST=100m
FRONTEND_MEMORY_LIMIT=256Mi
FRONTEND_CPU_LIMIT=200m

API_GATEWAY_MEMORY_REQUEST=256Mi
API_GATEWAY_CPU_REQUEST=200m
API_GATEWAY_MEMORY_LIMIT=512Mi
API_GATEWAY_CPU_LIMIT=400m

SERVICE_MEMORY_REQUEST=128Mi
SERVICE_CPU_REQUEST=100m
SERVICE_MEMORY_LIMIT=256Mi
SERVICE_CPU_LIMIT=200m

# Health check timings (production-like)
LIVENESS_DELAY=30
READINESS_DELAY=10

# Service names
ORDERS_SERVICE_NAME=orders-service
INVENTORY_SERVICE_NAME=inventory-service
USERS_SERVICE_NAME=users-service
REVIEWS_SERVICE_NAME=reviews-service
RATINGS_SERVICE_NAME=ratings-service

# Istio settings (enabled for staging)
ISTIO_ENABLED=true
ISTIO_FAULT_INJECTION=true
ISTIO_MTLS_MODE=STRICT